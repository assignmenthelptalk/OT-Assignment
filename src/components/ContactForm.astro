---
interface Props {
  headingText?: string;
  subText?: string;
  formId?: string;
  compact?: boolean;
  sidebar?: boolean;
}

const {
  headingText = 'Get a Free Quote for Your OT Assignment',
  subText = 'OT-qualified writers. Response within 24 hours.',
  formId = 'contact-form',
  compact = false,
  sidebar = false,
} = Astro.props;

const fieldClass = 'w-full px-3 py-2.5 border border-[var(--color-border)] rounded-lg bg-white text-[var(--color-text-primary)] focus:outline-none focus:ring-2 focus:ring-primary-600 text-sm';
const labelClass = 'block text-sm font-semibold text-primary-800 mb-1';

// Web3Forms delivers submissions straight to assignmenthelptalk@gmail.com without a
// backend. Get a free access key at https://web3forms.com and set it as
// PUBLIC_WEB3FORMS_ACCESS_KEY in the deployment environment (Vercel project settings).
const WEB3FORMS_ACCESS_KEY = import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY ?? '';
if (import.meta.env.DEV && !WEB3FORMS_ACCESS_KEY) {
  console.warn(
    '[ContactForm] PUBLIC_WEB3FORMS_ACCESS_KEY is not set — form submissions will fail. ' +
    'Get a key at https://web3forms.com and add it to .env.'
  );
}
---

<div id={formId} class={`bg-primary-50 border border-[var(--color-border)] rounded-xl ${sidebar ? 'p-5' : 'p-8 my-8'}`}>
  <h3 class="text-xl font-bold text-primary-800 mb-1">{headingText}</h3>
  <p class="text-sm text-[var(--color-text-secondary)] mb-6">{subText}</p>

  <form
    method="POST"
    action="https://api.web3forms.com/submit"
    data-quote-form
  >
    <input type="hidden" name="access_key" value={WEB3FORMS_ACCESS_KEY} />
    <input type="hidden" name="subject" value="New OT Assignment Quote Request" />
    <input type="hidden" name="from_name" value="OT Assignment Help Website" />
    <!-- Honeypot: real visitors never see or fill this in; bots usually do. -->
    <input
      type="checkbox"
      name="botcheck"
      class="hidden"
      tabindex="-1"
      autocomplete="off"
      aria-hidden="true"
    />

    <div class={compact ? 'grid grid-cols-1 sm:grid-cols-2 gap-4' : 'space-y-4'}>

      <div>
        <label for={`${formId}-name`} class={labelClass}>Your name *</label>
        <input
          type="text"
          id={`${formId}-name`}
          name="name"
          required
          placeholder="e.g. Sarah Jones"
          class={fieldClass}
        />
      </div>

      <div>
        <label for={`${formId}-email`} class={labelClass}>Email address *</label>
        <input
          type="email"
          id={`${formId}-email`}
          name="email"
          required
          placeholder="you@example.com"
          class={fieldClass}
        />
      </div>

      <div>
        <label for={`${formId}-type`} class={labelClass}>Assignment type *</label>
        <select
          id={`${formId}-type`}
          name="assignment-type"
          required
          class={fieldClass}
        >
          <option value="" disabled selected>Select assignment type</option>
          <option value="case-study">Case Study</option>
          <option value="reflective-essay">Reflective Essay / Journal</option>
          <option value="literature-review">Literature Review</option>
          <option value="activity-analysis">Activity Analysis</option>
          <option value="dissertation">Research Proposal / Dissertation</option>
          <option value="practice-placement">Practice Placement Portfolio</option>
          <option value="moho-cmop-e">MOHO / CMOP-E Essay</option>
          <option value="other">Other</option>
        </select>
      </div>

      <div>
        <label for={`${formId}-wordcount`} class={labelClass}>Word count</label>
        <input
          type="text"
          id={`${formId}-wordcount`}
          name="word-count"
          placeholder="e.g. 3,000 words"
          class={fieldClass}
        />
      </div>

      <div>
        <label for={`${formId}-deadline`} class={labelClass}>Deadline</label>
        <input
          type="date"
          id={`${formId}-deadline`}
          name="deadline"
          class={fieldClass}
        />
      </div>

      <div class={compact ? 'sm:col-span-2' : ''}>
        <label for={`${formId}-message`} class={labelClass}>Brief details</label>
        <textarea
          id={`${formId}-message`}
          name="message"
          rows="4"
          placeholder="Tell us about your assignment — topic, module, qualification level, and any specific requirements."
          class={`${fieldClass} resize-y`}
        ></textarea>
      </div>

    </div>

    <button
      type="submit"
      class="mt-6 bg-accent-500 hover:bg-accent-400 text-white font-semibold px-6 py-3 rounded-lg transition-colors duration-200 w-full sm:w-auto disabled:opacity-60 disabled:cursor-not-allowed"
    >
      Request a Free Quote
    </button>

    <p data-form-status role="status" aria-live="polite" class="mt-4 text-sm"></p>
  </form>
</div>

<script>
  // Progressive enhancement: submit via fetch so the page never reloads and we can
  // show inline success/error feedback. Delegated on `document` (rather than bound
  // per-form) so it works no matter how many ContactForm instances render on a page,
  // and the guard flag keeps it idempotent if Astro inlines this script more than once.
  const win = window as Window & { __otQuoteFormHandlerInstalled?: boolean };

  if (!win.__otQuoteFormHandlerInstalled) {
    win.__otQuoteFormHandlerInstalled = true;

    document.addEventListener('submit', async (event) => {
      const form = event.target;
      if (!(form instanceof HTMLFormElement) || !form.matches('[data-quote-form]')) return;

      event.preventDefault();

      const statusEl = form.querySelector('[data-form-status]');
      const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;
      const originalBtnText = submitBtn ? submitBtn.textContent : '';

      const setStatus = (text: string, tone?: 'error' | 'success') => {
        if (!statusEl) return;
        statusEl.textContent = text;
        statusEl.className =
          tone === 'error'
            ? 'mt-4 text-sm font-medium text-red-700'
            : 'mt-4 text-sm font-medium text-secondary-700';
      };

      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Sending...';
      }

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: new FormData(form),
        });
        const result = await response.json();

        if (response.ok && result.success) {
          form.reset();
          setStatus("Thanks — your request has been sent. We'll reply within 24 hours.");
        } else {
          throw new Error(result.message || 'Submission failed');
        }
      } catch (error) {
        console.error('[ContactForm] submission failed:', error);
        setStatus(
          'Sorry, something went wrong sending your request. Please email assignmenthelptalk@gmail.com directly.',
          'error'
        );
      } finally {
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = originalBtnText;
        }
      }
    });
  }
</script>
